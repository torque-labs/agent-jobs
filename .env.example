# Postgres connection string (existing Coolify Postgres or local for dev)
DATABASE_URL=postgres://user:pass@localhost:5432/agent_jobs

# Hermes Agent gateway (OpenAI-compatible)
HERMES_API_URL=http://hermes-agent-cookw4kwo0gw0gock8wgwgwk:8642
HERMES_API_TOKEN=

# Outline (publisher destination for digest job)
OUTLINE_BASE_URL=https://outline.coolify.torque.so
OUTLINE_API_KEY=

# OpenRouter (used by chat-translator endpoint only; not for orchestrator steps)
OPENROUTER_API_KEY=

# Basic-auth fallback. Keep ALLOW_BASIC_AUTH=true while Supabase OAuth is being
# wired up; flip to false once everyone has a @torque.so Google account.
APP_PASSWORD=change-me
ALLOW_BASIC_AUTH=true

# Supabase (Google OAuth, restricted to @torque.so). Optional — when these are
# unset the proxy falls back to basic auth and the login page hides the Google
# button. See README "Supabase setup" for the one-time provisioning steps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Multi-tenant Hermes customer-agent runtime
# ---------------------------------------------------------------------------
# The runtime drives OpenRouter directly (OPENROUTER_API_KEY above) and injects
# each tenant's scoped Torque MCP token per request — there is no global Torque
# token for tenant turns. Provisioning + channel sends hit the network; keep
# the *_SEND_DISABLED flags on for local/dry-run testing.
TORQUE_API_URL=https://server.torque.so
# Disable outbound channel sends while testing (log instead of POST):
TELEGRAM_SEND_DISABLED=true
SLACK_SEND_DISABLED=true

# --- $TRUMP seed tenant (seed/trump-tenant.ts). Never commit real values. ---
# export TRUMP_TORQUE_MCP_TOKEN="$(cat ~/.claude/jobs/64a69244/trump_torque_mcp_token.txt)"
TRUMP_TORQUE_MCP_TOKEN=
TRUMP_TORQUE_INGEST_KEY=
# Optional channel wiring for the $TRUMP tenant:
TRUMP_TELEGRAM_BOT_TOKEN=
TRUMP_TELEGRAM_WEBHOOK_SECRET=
TRUMP_TELEGRAM_ALLOWED_CHATS=
TRUMP_SLACK_BOT_TOKEN=
TRUMP_SLACK_SIGNING_SECRET=
TRUMP_SLACK_ALLOWED_CHANNELS=

NODE_ENV=development
